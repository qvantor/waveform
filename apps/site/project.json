{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/site/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "astro build", "cwd": "apps/site" },
      "inputs": ["production"],
      "outputs": ["{workspaceRoot}/dist/apps/site"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "astro dev", "cwd": "apps/site" },
      "continuous": true
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "astro check", "cwd": "apps/site" }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node --test 'apps/site/tests/*.test.mjs'" }
    }
  }
}
