---
import { ART, artFrames, svgArea, svgPoints } from '../art/wavetable';

// a wavetable as the synth draws one on its dark screens: its frames stacked in depth, a sine growing into a saw,
// the played frame bright and filled to its zero line; still (time 0: where the canvas of art.ts starts moving it)
const frames = artFrames(0);
---

<svg viewBox={`0 0 ${ART.width} ${ART.height}`} aria-hidden='true'>
  <defs>
    <linearGradient id='art-fill' x1='0' y1='0' x2='0' y2='1'>
      <stop offset='0' stop-color='#2ecc71' stop-opacity='0.38'></stop>
      <stop offset='1' stop-color='#2ecc71' stop-opacity='0.03'></stop>
    </linearGradient>
  </defs>
  <g fill='none' stroke-linejoin='round'>
    {frames.map((frame) => (
      <>
        {frame.glow > 0 && (
          <polygon points={svgArea(frame)} fill='url(#art-fill)' fill-opacity={frame.glow} stroke='none' />
        )}
        <polyline
          points={svgPoints(frame.xy)}
          stroke={frame.color}
          stroke-opacity={frame.alpha.toFixed(2)}
          stroke-width={(1.1 + 1.4 * frame.glow).toFixed(2)}
        />
      </>
    ))}
  </g>
</svg>
