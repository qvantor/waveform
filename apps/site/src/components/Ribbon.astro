---
import { ribbon } from '../art/wavetable';

interface Props {
  // the id of its gradient (one per page)
  id: string;
}

// the voices of a unison across a dark band: sines a little apart, the blue of the logo into its green
const { id } = Astro.props;
const WIDTH = 1200;
const HEIGHT = 220;
const lines = ribbon(WIDTH, HEIGHT);
---

<svg class='ribbon' viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio='none' aria-hidden='true'>
  <defs>
    <linearGradient id={id} x1='0' y1='0' x2='1' y2='0'>
      <stop offset='0' stop-color='#3498db'></stop>
      <stop offset='0.8' stop-color='#2ecc71'></stop>
    </linearGradient>
  </defs>
  <g fill='none' stroke={`url(#${id})`} stroke-width='1.6'>
    {lines.map((line) => (
      <path d={line.d} stroke-opacity={line.opacity} vector-effect='non-scaling-stroke' />
    ))}
  </g>
</svg>

<style>
  .ribbon {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
