{
  "name": "waveform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/waveform/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/waveform"],
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {},
        "perf": {}
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/dsp/goldens/**/*",
        "{workspaceRoot}/dsp/measurements/**/*",
        {
          "runtime": "cat tmp/wasm-perf/*.wasm 2>/dev/null | git hash-object --stdin"
        },
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest", "@nx/react", "babel-jest"]
        }
      ]
    }
  }
}
