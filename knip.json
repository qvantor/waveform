{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/waveform/src/main.tsx",
    "apps/waveform/src/polyfills.ts",
    "apps/waveform/src/**/*.worklet.ts",
    "apps/waveform/src/**/*.worker.ts",
    "libs/*/src/index.ts",
    "netlify/functions/*.{ts,mts}",
    "scripts/*.mjs",
    "{apps/*,libs/*,netlify}/jest.config.ts",
    "**/*.spec.{ts,tsx}",
    "apps/waveform/src/test-setup.ts",
    "apps/waveform/src/test-utils/*.{ts,tsx}",
    "apps/waveform/__mocks__/*.ts"
  ],
  "project": ["apps/**/*.{ts,tsx,js}", "libs/**/*.{ts,tsx}", "netlify/**/*.{ts,mts}", "scripts/**/*.mjs"],
  "babel": {
    "config": ["babel.config.json", "{apps,libs}/*/.babelrc"]
  },
  "jest": false,
  "ignoreDependencies": [
    "@nrwl/cli",
    "@nrwl/workspace",
    "@nrwl/webpack",
    "@jest/globals",
    "jest-environment-jsdom",
    "babel-jest",
    "ts-jest",
    "ts-node",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks"
  ],
  "ignoreBinaries": ["mkcert"],
  "ignoreUnresolved": ["^[\\w-]+=apps/waveform/src/.+\\.(worklet|worker)\\.ts$"],
  "ignoreExportsUsedInFile": true
}
