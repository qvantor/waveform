{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/chisper/src/main.tsx",
    "apps/chisper/src/polyfills.ts",
    "apps/chisper/src/**/*.worklet.ts",
    "apps/chisper/src/**/*.worker.ts",
    "apps/chisper/src/app/perf/perf-hook.perf.tsx",
    "apps/chisper/webpack.config.js",
    "libs/*/src/index.ts",
    "netlify/functions/*.{ts,mts}",
    "scripts/*.mjs",
    "scripts/bench-osc/run.mjs",
    "scripts/bench-perf/run.mjs",
    "scripts/wasm-browsers/run.mjs",
    "scripts/wasm-browsers/app.mjs",
    "scripts/renders/run.mjs",
    "scripts/noises/process.mjs",
    "scripts/noises/add.mjs",
    "scripts/noises/upload.mjs",
    "scripts/**/*.test.mjs",
    "{apps/*,libs/*,netlify}/jest.config.ts",
    "{apps,libs,netlify}/**/*.spec.{ts,tsx}",
    "{apps/chisper,libs/ui-kit}/src/test-setup.ts",
    "apps/chisper/src/test-utils/*.{ts,tsx}",
    "apps/chisper/__mocks__/*.ts",
    "dsp/gen/*.{mjs,ts}",
    "apps/chisper/wasm-babel-plugin.js",
    "scripts/site/*.mjs",
    "apps/site/tests/*.test.mjs"
  ],
  "project": [
    "apps/**/*.{ts,tsx,js}",
    "apps/site/src/**/*.astro",
    "libs/**/*.{ts,tsx}",
    "netlify/**/*.{ts,mts}",
    "scripts/**/*.mjs",
    "dsp/gen/*.{mjs,ts}"
  ],
  "babel": {
    "config": ["babel.config.json", "{apps,libs}/*/.babelrc"]
  },
  "jest": false,
  "ignoreDependencies": [
    "@nx/workspace",
    "@jest/globals",
    "jest-environment-jsdom",
    "ts-node",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "playwright",
    "@babel/plugin-transform-exponentiation-operator",
    "@babel/plugin-transform-modules-commonjs",
    "react-refresh",
    "@pmmmwh/react-refresh-webpack-plugin"
  ],
  "ignoreBinaries": ["mkcert", "caffeinate", "notifyutil", "swiftc", "afconvert", "afinfo"],
  "ignoreUnresolved": ["^[\\w.-]+=apps/chisper/src/.+\\.(worklet|worker)\\.ts$"],
  "ignoreExportsUsedInFile": true,
  "astro": {
    "config": ["apps/site/astro.config.mjs"],
    "entry": ["apps/site/src/pages/**/*.astro"]
  },
  "eslint": {
    "config": ["eslint.config.mjs", "{apps,libs}/*/eslint.config.mjs"]
  }
}
