{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/waveform/src/main.tsx",
    "apps/waveform/src/polyfills.ts",
    "apps/waveform/src/**/*.worklet.ts",
    "apps/waveform/src/**/*.worker.ts",
    "apps/waveform/src/app/perf/perf-hook.perf.tsx",
    "apps/waveform/webpack.config.js",
    "libs/*/src/index.ts",
    "netlify/functions/*.{ts,mts}",
    "scripts/*.mjs",
    "scripts/bench-osc/run.mjs",
    "scripts/bench-perf/run.mjs",
    "scripts/**/*.test.mjs",
    "{apps/*,libs/*,netlify}/jest.config.ts",
    "**/*.spec.{ts,tsx}",
    "{apps/waveform,libs/ui-kit}/src/test-setup.ts",
    "apps/waveform/src/test-utils/*.{ts,tsx}",
    "apps/waveform/__mocks__/*.ts"
  ],
  "project": ["apps/**/*.{ts,tsx,js}", "libs/**/*.{ts,tsx}", "netlify/**/*.{ts,mts}", "scripts/**/*.mjs"],
  "babel": {
    "config": ["babel.config.json", "{apps,libs}/*/.babelrc"]
  },
  "jest": false,
  "ignoreDependencies": [
    "@nrwl/cli",
    "@nrwl/workspace",
    "@nrwl/webpack",
    "@jest/globals",
    "jest-environment-jsdom",
    "babel-jest",
    "ts-jest",
    "ts-node",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "playwright"
  ],
  "ignoreBinaries": ["mkcert", "caffeinate", "notifyutil"],
  "ignoreUnresolved": ["^[\\w-]+=apps/waveform/src/.+\\.(worklet|worker)\\.ts$"],
  "ignoreExportsUsedInFile": true
}
