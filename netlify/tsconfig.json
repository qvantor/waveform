{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2020", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.mts"],
  // legacy S3 functions were written without strict mode
  "exclude": ["functions/get-wavetable.ts", "functions/get-wavetables-list.ts", "utils/index.ts"]
}
