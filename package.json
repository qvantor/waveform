{
  "name": "waveform",
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "concurrently -k -p \"[{name}]\" -n \"api,client\" -c  \"yellow.bold,green.bold\" \"netlify dev\" \"npm run client:start\"",
    "client:start": "npm run wasm -- --only=prod && npm run worklets && concurrently -k -n wasm,worklets,serve \"npm run wasm -- --only=prod --watch\" \"npm run worklets -- --watch=forever\" \"nx serve\"",
    "build": "npm run wasm -- --only=prod && npm run worklets -- --minify && nx build",
    "build:perf": "npm run wasm -- --only=perf && npm run worklets -- --minify --define:__PERF__=true --alias:@waveform/wasm=./tmp/wasm-perf --outdir=tmp/worklets-perf && nx build waveform --configuration=perf --skip-nx-cache",
    "wasm": "node scripts/wasm.mjs",
    "dsp:check": "cd dsp && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test --quiet && cd .. && node scripts/wasm.mjs --check-sizes",
    "worklets": "esbuild reverb=apps/waveform/src/app/synth/fx/effects/reverb.worklet.ts limiter=apps/waveform/src/app/synth/common/limiter/limiter.worklet.ts distortion=apps/waveform/src/app/synth/fx/effects/distortion.worklet.ts fx-mod=apps/waveform/src/app/synth/fx/effects/fx-mod.worklet.ts wavetable-osc=apps/waveform/src/app/synth/common/wavetable/wavetable-osc.worklet.ts wavetable-worker=apps/waveform/src/app/synth/common/wavetable/wavetable.worker.ts --bundle --format=esm --loader:.wasm=binary --supported:from-base64=false --define:__PERF__=false --log-level=warning --outdir=tmp/worklets",
    "test": "nx test",
    "test:all": "npm run wasm -- --only=perf && nx run-many --target=test --all",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "lint": "nx run-many --target=lint --all",
    "prettier:check": "prettier -l './apps/**/*.{ts,tsx}' './libs/**/*.{ts,tsx}' './netlify/**/*.{ts,mts}' './scripts/**/*.{mjs,ts}' './dsp/gen/*.{mjs,ts}'",
    "prettier:fix": "prettier --write './apps/**/*.{ts,tsx}' './libs/**/*.{ts,tsx}' './netlify/**/*.{ts,mts}' './scripts/**/*.{mjs,ts}' './dsp/gen/*.{mjs,ts}'",
    "typecheck": "tsc -p apps/waveform/tsconfig.app.json --noEmit && tsc -p apps/waveform/tsconfig.spec.json --noEmit && tsc -p libs/math/tsconfig.lib.json --noEmit && tsc -p libs/math/tsconfig.spec.json --noEmit && tsc -p libs/preset-schema/tsconfig.lib.json --noEmit && tsc -p libs/preset-schema/tsconfig.spec.json --noEmit && tsc -p libs/rxjs-react/tsconfig.lib.json --noEmit && tsc -p libs/rxjs-react/tsconfig.spec.json --noEmit && tsc -p libs/ui-kit/tsconfig.lib.json --noEmit && tsc -p libs/ui-kit/tsconfig.spec.json --noEmit && tsc -p netlify/tsconfig.json --noEmit && tsc -p netlify/tsconfig.spec.json --noEmit",
    "knip": "knip",
    "certs": "node scripts/certs.mjs",
    "precheck": "npm run prettier:check && npm run typecheck && npm run lint && npm run knip && npm run dsp:check && npm run test:all && npm run test:scripts"
  },
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "^3.245.0",
    "@aws-sdk/s3-request-presigner": "^3.245.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@marsidev/react-turnstile": "^1.6.1",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-query": "^4.18.0",
    "@types/webmidi": "^2.0.6",
    "antd": "^5.0.7",
    "classnames": "^2.3.2",
    "core-js": "^3.6.5",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.1.0",
    "fft.js": "^4.0.4",
    "hex-to-rgba": "^2.0.1",
    "lodash": "^4.17.21",
    "obscenity": "^0.4.6",
    "postgres": "^3.4.9",
    "pretty-bytes": "^6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^4.8.0",
    "react-is": "18.3.1",
    "regenerator-runtime": "0.13.7",
    "rxjs": "^7.5.7",
    "styled-components": "5.3.6",
    "tslib": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/plugin-transform-exponentiation-operator": "7.18.6",
    "@netlify/functions": "^2.8.2",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/jest": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/react": "24.0.3",
    "@nx/webpack": "24.0.3",
    "@nx/workspace": "24.0.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.2",
    "@types/d3-shape": "^3.1.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.188",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/react-is": "18.3.0",
    "@types/styled-components": "5.1.26",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "30.3.0",
    "babel-plugin-styled-components": "1.10.7",
    "binaryen": "132.0.0",
    "concurrently": "^7.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.0.5",
    "jest-util": "30.0.5",
    "knip": "^6.41.0",
    "netlify-cli": "^27.12.0",
    "nx": "24.0.3",
    "prettier": "^2.6.2",
    "react-refresh": "^0.10.0",
    "standardized-audio-context-mock": "^10.0.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "5.112.2",
    "webpack-cli": "^7.0.0"
  }
}
