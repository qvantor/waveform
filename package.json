{
  "name": "waveform",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -k -p \"[{name}]\" -n \"api,client\" -c  \"yellow.bold,green.bold\" \"netlify dev\" \"npm run client:start\"",
    "client:start": "npm run worklets && concurrently -k -n worklets,serve \"npm run worklets -- --watch=forever\" \"nx serve\"",
    "build": "npm run worklets -- --minify && nx build",
    "worklets": "esbuild reverb=apps/waveform/src/app/synth/fx/effects/reverb.worklet.ts limiter=apps/waveform/src/app/synth/common/limiter/limiter.worklet.ts --bundle --format=esm --log-level=warning --outdir=tmp/worklets",
    "test": "nx test",
    "test:all": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "prettier:check": "prettier -l './apps/**/*.{ts,tsx}' './libs/**/*.{ts,tsx}' './netlify/**/*.{ts,mts}' './scripts/*.mjs'",
    "prettier:fix": "prettier --write './apps/**/*.{ts,tsx}' './libs/**/*.{ts,tsx}' './netlify/**/*.{ts,mts}' './scripts/*.mjs'",
    "typecheck": "tsc -p apps/waveform/tsconfig.app.json --noEmit && tsc -p apps/waveform/tsconfig.spec.json --noEmit && tsc -p libs/math/tsconfig.lib.json --noEmit && tsc -p libs/math/tsconfig.spec.json --noEmit && tsc -p libs/preset-schema/tsconfig.lib.json --noEmit && tsc -p libs/preset-schema/tsconfig.spec.json --noEmit && tsc -p libs/rxjs-react/tsconfig.lib.json --noEmit && tsc -p libs/rxjs-react/tsconfig.spec.json --noEmit && tsc -p libs/ui-kit/tsconfig.lib.json --noEmit && tsc -p libs/ui-kit/tsconfig.spec.json --noEmit && tsc -p netlify/tsconfig.json --noEmit && tsc -p netlify/tsconfig.spec.json --noEmit",
    "knip": "knip",
    "certs": "node scripts/certs.mjs",
    "precheck": "npm run prettier:check && npm run typecheck && npm run lint && npm run knip && npm run test:all"
  },
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "@aws-sdk/client-s3": "^3.245.0",
    "@aws-sdk/s3-request-presigner": "^3.245.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@marsidev/react-turnstile": "^1.6.1",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-query": "^4.18.0",
    "@types/webmidi": "^2.0.6",
    "antd": "^5.0.7",
    "classnames": "^2.3.2",
    "core-js": "^3.6.5",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.1.0",
    "fft.js": "^4.0.4",
    "hex-to-rgba": "^2.0.1",
    "lodash": "^4.17.21",
    "obscenity": "^0.4.6",
    "postgres": "^3.4.9",
    "pretty-bytes": "^6.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^4.8.0",
    "react-is": "18.2.0",
    "regenerator-runtime": "0.13.7",
    "rxjs": "^7.5.7",
    "styled-components": "5.3.5",
    "tslib": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@nrwl/cli": "14.8.4",
    "@nrwl/eslint-plugin-nx": "14.8.4",
    "@nrwl/jest": "14.8.4",
    "@nrwl/linter": "14.8.4",
    "@nrwl/react": "^15.2.0",
    "@nrwl/web": "^15.2.0",
    "@nrwl/workspace": "14.8.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.2",
    "@types/d3-shape": "^3.1.0",
    "@types/jest": "28.1.1",
    "@types/lodash": "^4.14.188",
    "@types/node": "16.11.7",
    "@types/react": "18.0.20",
    "@types/react-dom": "18.0.6",
    "@types/react-is": "17.0.3",
    "@types/styled-components": "5.1.26",
    "@typescript-eslint/eslint-plugin": "^5.36.1",
    "@typescript-eslint/parser": "^5.36.1",
    "babel-jest": "28.1.1",
    "babel-plugin-styled-components": "1.10.7",
    "concurrently": "^7.6.0",
    "esbuild": "^0.28.1",
    "eslint": "~8.15.0",
    "eslint-config-prettier": "8.1.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-jsx-a11y": "6.6.1",
    "eslint-plugin-react": "7.31.8",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "28.1.1",
    "jest-environment-jsdom": "28.1.1",
    "knip": "^6.41.0",
    "netlify-cli": "^27.12.0",
    "nx": "14.8.4",
    "prettier": "^2.6.2",
    "standardized-audio-context-mock": "^10.0.1",
    "ts-jest": "28.0.5",
    "ts-node": "10.9.1",
    "typescript": "~4.8.2"
  }
}
