{
  "name": "chisper",
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "concurrently -k -p \"[{name}]\" -n \"api,client\" -c  \"yellow.bold,green.bold\" \"netlify dev --filter chisper\" \"npm run client:start\"",
    "client:start": "npm run wasm -- --only=prod && npm run worklets && concurrently -k -n wasm,worklets,serve \"npm run wasm -- --only=prod --watch\" \"npm run worklets -- --watch=forever\" \"nx serve\"",
    "build": "npm run wasm -- --only=prod && npm run worklets -- --minify && nx build && nx build site && node scripts/site/merge.mjs",
    "build:perf": "npm run wasm -- --only=perf && npm run worklets -- --minify --define:__PERF__=true --alias:@chisper/wasm=./tmp/wasm-perf --outdir=tmp/worklets-perf && nx build chisper --configuration=perf --skip-nx-cache",
    "wasm": "node scripts/wasm.mjs",
    "dsp:check": "cd dsp && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test --quiet && cd .. && node scripts/wasm.mjs --check-sizes",
    "worklets": "esbuild reverb=apps/chisper/src/app/synth/fx/effects/reverb.worklet.ts limiter=apps/chisper/src/app/synth/common/limiter/limiter.worklet.ts distortion=apps/chisper/src/app/synth/fx/effects/distortion.worklet.ts fx-mod=apps/chisper/src/app/synth/fx/effects/fx-mod.worklet.ts wavetable-osc=apps/chisper/src/app/synth/common/wavetable/wavetable-osc.worklet.ts wavetable-worker=apps/chisper/src/app/synth/common/wavetable/wavetable.worker.ts --bundle --format=esm --loader:.wasm=binary --supported:from-base64=false --define:__PERF__=false --log-level=warning --outdir=tmp/worklets",
    "test": "nx test",
    "test:all": "npm run wasm -- --only=perf && nx run-many --target=test --all",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "lint": "nx run-many --target=lint --all",
    "prettier:check": "prettier -l './apps/**/*.{ts,tsx,astro}' './apps/site/**/*.{mjs,css}' './libs/**/*.{ts,tsx}' './netlify/**/*.{ts,mts}' './scripts/**/*.{mjs,ts}' './dsp/gen/*.{mjs,ts}'",
    "prettier:fix": "prettier --write './apps/**/*.{ts,tsx,astro}' './apps/site/**/*.{mjs,css}' './libs/**/*.{ts,tsx}' './netlify/**/*.{ts,mts}' './scripts/**/*.{mjs,ts}' './dsp/gen/*.{mjs,ts}'",
    "typecheck": "tsc -p apps/chisper/tsconfig.app.json --noEmit && tsc -p apps/chisper/tsconfig.spec.json --noEmit && tsc -p libs/math/tsconfig.lib.json --noEmit && tsc -p libs/math/tsconfig.spec.json --noEmit && tsc -p libs/preset-schema/tsconfig.lib.json --noEmit && tsc -p libs/preset-schema/tsconfig.spec.json --noEmit && tsc -p libs/rxjs-react/tsconfig.lib.json --noEmit && tsc -p libs/rxjs-react/tsconfig.spec.json --noEmit && tsc -p libs/ui-kit/tsconfig.lib.json --noEmit && tsc -p libs/ui-kit/tsconfig.spec.json --noEmit && tsc -p netlify/tsconfig.json --noEmit && tsc -p netlify/tsconfig.spec.json --noEmit && tsc -p apps/site/tsconfig.spec.json --noEmit && astro check --root apps/site",
    "knip": "knip",
    "certs": "node scripts/certs.mjs",
    "precheck": "npm run prettier:check && npm run typecheck && npm run lint && npm run knip && npm run dsp:check && npm run test:all && npm run test:scripts && nx run site:verify"
  },
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.105.3",
    "antd": "^6.6.8",
    "classnames": "^2.5.1",
    "core-js": "^3.51.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "fft.js": "^4.0.4",
    "hex-to-rgba": "^2.0.1",
    "lodash": "^4.18.1",
    "obscenity": "^0.4.6",
    "postgres": "^4.0.0",
    "pretty-bytes": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "regenerator-runtime": "^0.14.1",
    "rxjs": "^7.8.2",
    "styled-components": "^6.6.0",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@babel/core": "^7.14.5",
    "@babel/plugin-transform-exponentiation-operator": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@netlify/functions": "^6.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/jest": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/react": "24.0.3",
    "@nx/webpack": "24.0.3",
    "@nx/workspace": "24.0.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "astro": "^7.4.5",
    "babel-jest": "^30.5.2",
    "babel-plugin-styled-components": "^2.4.0",
    "binaryen": "132.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-util": "^30.5.1",
    "jsdom": "^26.1.0",
    "knip": "^6.44.1",
    "netlify-cli": "^27.16.2",
    "nx": "24.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "react-refresh": "^0.19.0",
    "standardized-audio-context-mock": "^10.0.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "5.112.2",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.7"
  }
}
