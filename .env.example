# Copy to `.env` for local development (`netlify dev` and Nx both read it).
# In production set the same variables in Netlify: Site configuration → Environment variables.

# --- S3 with wavetables (already used) ---
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# --- Postgres (Supabase or Neon) ---
# Use the pooled connection string, e.g.
# Neon:     postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supabase: postgres://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# Then apply db/migrations/*.sql to the database.
DATABASE_URL=

# --- Cloudflare Turnstile ---
# Widget mode: "Invisible" or "Managed" (managed shows a checkbox only when interaction is needed).
# Add every hostname you use to the widget in Cloudflare, including `localhost` for local dev,
# otherwise the widget fails with error 110200.
# The values below are Cloudflare test keys that always pass (convenient for local dev),
# replace them with real keys in production. Site key and secret must belong to the same widget.
# NX_ prefix is required: Nx inlines NX_* variables into the client bundle at build time.
NX_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Presets ---
# Long random string, e.g. `openssl rand -hex 32`. Changing it resets rate limits and usage uniqueness.
IP_HASH_SALT=
# Listeners are counted by IP (an IPv6 /64), the author's IP excluded: an IP that played a preset for 10 seconds during
# the last 60 days; it stayed if it played the preset for a minute, both without switching to another one.
# A preset leaves quarantine (gets a score) with this many listeners who stayed.
MIN_UNIQUE_USERS=2
# A preset is in Popular with this many listeners who stayed during the last 60 days, and a share of its listeners
# who stayed not below the share of the site (listens and stays weighted with a 7 days half-life).
POPULAR_MIN_USERS=10
# The score is the share of listeners who stayed, pulled to the share of the site as if the preset had this many
# more listeners: a preset with few listeners scores near the average. In the share of the site a preset weighs as at
# most this many listeners: the traffic of Popular doesn't make the average.
SCORE_PRIOR_LISTENERS=10
# A preset is hidden after this many reports from different IPs during the last 180 days.
REPORT_HIDE_THRESHOLD=5

# --- The renders of an Audio Unit (scripts/renders: manual, macOS) ---
# The Audio Unit as the fourCCs of its component, <type>:<subtype>:<manufacturer>.
RENDERS_AU=
